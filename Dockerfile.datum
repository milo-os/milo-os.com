# syntax=docker/dockerfile:1

# Image for the Datum Compute unikernel runtime.
# `datumctl compute build` uses this file instead of Dockerfile when it exists.
# The final stage is packaged as the unikernel root filesystem, so it needs the
# bun binary, its shared libraries and the app, and nothing that needs a shell.
# The regular Dockerfile still builds the Kubernetes and the general-purpose
# image. CI does not use this file: the site runs on the general-purpose runtime.

# The unikernel base is x86_64, so pin the platform (the build host may be arm64).
FROM --platform=linux/amd64 oven/bun:1.3-slim AS build
WORKDIR /app

COPY package.json bun.lock ./
RUN bun install

COPY . .
RUN bun run build

FROM --platform=linux/amd64 oven/bun:1.3-slim
WORKDIR /app

# Datum networks are IPv6 only, so listen on :: (an IPv4-only socket never
# answers). The root filesystem is held in memory, so the transpiler cache goes
# to /tmp.
ENV NODE_ENV=production \
    PORT=4321 \
    HOST=:: \
    BUN_RUNTIME_TRANSPILER_CACHE_PATH=/tmp/bun-transpiler-cache

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/server.mjs ./server.mjs

EXPOSE 4321

# Exec form: the unikernel starts the entrypoint directly, without a shell.
CMD ["bun", "./server.mjs"]
